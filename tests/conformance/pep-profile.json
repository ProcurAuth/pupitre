{
  "pep": {
    "service": "pupitre",
    "token": {
      "header": "X-Identity-Token",
      "iss": "https://edge.example.invalid",
      "max_age_seconds": 300,
      "skew_seconds": 30,
      "keys": [
        { "alg": "Ed25519", "kid": "edge-ed25519", "file": "keys/edge-ed25519.pk8" },
        { "alg": "ES256", "kid": "edge-es256", "file": "keys/edge-es256.pk8" }
      ]
    },
    "pdp": {
      "listen": "127.0.0.1:8181",
      "credential_file": "pdp-credential.txt"
    },
    "answer_cache": false,
    "options_type": "environment",
    "reset": { "method": "POST", "path": "/conformance/reset" },
    "operations": {
      "use_plain": {
        "method": "GET",
        "path": "/conformance/plain",
        "action": "config.read",
        "resource_type": "host",
        "resource_id": "host-a",
        "ancestors": [
          { "type": "service", "id": "pupitre" },
          { "type": "environment", "id": "production" },
          { "type": "unit", "id": "relay" }
        ]
      },
      "use_ceiling": {
        "method": "GET",
        "path": "/conformance/ceiling",
        "action": "run.apply",
        "resource_type": "unit",
        "resource_id": "relay",
        "ancestors": [
          { "type": "service", "id": "pupitre" },
          { "type": "environment", "id": "production" }
        ],
        "ceiling": "max_hosts",
        "ceiling_value": 100
      },
      "use_service": {
        "method": "GET",
        "path": "/conformance/service",
        "action": "inventory.write"
      }
    }
  },
  "timeouts": {
    "request_seconds": 10,
    "case_seconds": 60,
    "settle_ms": 25
  }
}
