# Host image of the acceptance tests: a Debian host with systemd and sshd.
# The harness starts it as a throwaway container on a private network. It holds no key:
# the harness mounts the host key and the authorized key at run time.
# Never push this image to a registry.
FROM debian:trixie-slim@sha256:a72b4433de1cf7d6bae0c4cee74d0547f58601a643b3375f070c51600d63b6b2

RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      systemd systemd-sysv dbus openssh-server python3 sudo procps iproute2 \
 && rm -rf /var/lib/apt/lists/* /etc/ssh/ssh_host_* \
 && useradd --create-home --shell /bin/bash --uid 2000 deploy \
 && printf 'deploy ALL=(ALL) NOPASSWD:ALL\n' > /etc/sudoers.d/deploy \
 && chmod 0440 /etc/sudoers.d/deploy \
 && systemctl enable ssh.service \
 && systemctl mask getty.target console-getty.service systemd-logind.service \
      systemd-timesyncd.service apt-daily.timer apt-daily-upgrade.timer \
 && mkdir -p /etc/ssh/sshd_config.d /etc/ssh/acceptance

COPY sshd-acceptance.conf /etc/ssh/sshd_config.d/10-acceptance.conf

STOPSIGNAL SIGRTMIN+3
EXPOSE 22
CMD ["/sbin/init"]
