{
  "format": 1,
  "group": "relay_hosts",
  "keys": [
    {
      "description": "The password of the relay account.",
      "kind": "text",
      "max": 1024,
      "min": 8,
      "path": "auth.password",
      "rule": "any",
      "secret": true
    },
    {
      "default": 100,
      "description": "The most clients at one time.",
      "kind": "integer",
      "max": 100000,
      "min": 1,
      "path": "limits.max_clients"
    },
    {
      "default": "info",
      "description": "The lowest level of the log.",
      "kind": "enum",
      "path": "log.level",
      "values": [
        "error",
        "warn",
        "info",
        "debug"
      ]
    },
    {
      "default": "5s",
      "description": "The time to open one connection.",
      "kind": "duration",
      "max": "5m",
      "min": "1s",
      "path": "timeouts.connect"
    }
  ],
  "variable": "relay_config"
}
